{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "esModuleInterop": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": ["package.json", "**/*.ts"],
  "exclude": ["node_modules", "**/*.spec.ts", "vitest.config.ts"]
}
