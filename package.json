{
  "name": "nickel-scm",
  "type": "module",
  "version": "0.14.4",
  "description": "Handle tasks on multiple local Git repositories",
  "repository": {
    "type": "git",
    "url": "https://github.com/bredmold/nickel.git"
  },
  "scripts": {
    "build": "tsc && chmod a+x dist/src/nickel.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "format": "prettier --write '**/*.ts'",
    "lint": "eslint . --ext .ts",
    "preversion": "npm run test",
    "version": "npm run build",
    "postversion": "git push && git push --tags && npm publish",
    "nickel": "node dist/src/nickel.js"
  },
  "bin": {
    "nickel": "dist/src/nickel.js"
  },
  "keywords": [
    "git"
  ],
  "author": "Aaron Goldstein",
  "license": "MIT",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/tmp": "^0.2.6",
    "eslint": "^10.8.1",
    "import-sort-style-eslint": "^6.0.0",
    "jest": "^30.4.2",
    "jest-util": "^30.4.1",
    "prettier": "^3.4.2",
    "prettier-plugin-import-sort": "^0.0.7",
    "tmp": "^0.2.7",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  },
  "dependencies": {
    "@types/node": "^26.2.0",
    "chalk": "^4.1.2",
    "commander": "^15.0.0",
    "winston": "^3.19.0"
  },
  "importSort": {
    ".ts": {
      "style": "eslint",
      "parser": "typescript"
    }
  }
}
