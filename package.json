{
  "name": "nickel-scm",
  "version": "0.14.4",
  "description": "Handle tasks on multiple local Git repositories",
  "repository": {
    "type": "git",
    "url": "https://github.com/bredmold/nickel.git"
  },
  "scripts": {
    "build": "tsc && chmod a+x dist/src/nickel.js",
    "test": "jest",
    "coverage": "jest --coverage",
    "format": "prettier --write '**/*.ts'",
    "lint": "eslint . --ext .ts",
    "preversion": "npm run test",
    "version": "npm run build",
    "postversion": "git push && git push --tags && npm publish",
    "nickel": "node dist/src/nickel.js"
  },
  "bin": {
    "nickel": "dist/src/nickel.js"
  },
  "keywords": [
    "git"
  ],
  "author": "Aaron Goldstein",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/tmp": "^0.2.6",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.1",
    "import-sort-style-eslint": "^6.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "prettier-plugin-import-sort": "^0.0.7",
    "tmp": "^0.2.3",
    "ts-jest": "^29.2.5",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "@types/node": "^20.17.10",
    "chalk": "^4.1.2",
    "commander": "^11.0.0",
    "winston": "^3.17.0"
  },
  "importSort": {
    ".ts": {
      "style": "eslint",
      "parser": "typescript"
    }
  }
}
