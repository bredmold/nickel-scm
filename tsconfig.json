{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "esModuleInterop": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "./dist",
    "sourceMap": true,
    "strict": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": ["package.json", "src/**/*.ts"],
  "exclude": ["node_modules", "src/**/*.spec.ts"]
}
